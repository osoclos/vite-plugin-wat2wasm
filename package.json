{
    "name": "vite-plugin-wat2wasm",
    "type": "module",
    "version": "1.2.6",
    "description": "Enable .wat compilation and integrate generated WebAssembly modules into your codebase with type support",

    "author": "osoclos",
    "license": "MIT",

    "homepage": "https://github.com/osoclos/vite-plugin-wat2wasm#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/osoclos/vite-plugin-wat2wasm.git"
    },

    "bugs": { "url": "https://github.com/osoclos/vite-plugin-wat2wasm/issues" },

    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",

    "files": ["dist"],
    "exports": {
        ".": "./dist/index.js",
        "./module-types": "./dist/modules.d.ts",

        "./package.json": "./package.json"
    },

    "scripts": {
        "dev-dev"  : "concurrently 'bun run build' 'vitest watch'",
        "dev-build": "concurrently 'bun run build' 'vite build --watch --config tests/build/vite.config.ts' 'vite preview --config tests/build/vite.config.ts'",

        "build": "tsdown && bun run scripts/post-build.ts",
        "build-watch": "tsdown --watch --on-success 'bun run scripts/post-build.ts'",

        "test-dev"  : "vitest",
        "test-build": "vite build --watch --config tests/build/vite.config.ts && vite preview --config tests/build/vite.config.ts",

        "bump": "tsdown && bun run scripts/post-build.ts && bumpp"
    },

    "dependencies": { "wabt": "^1.0.39" },
    "devDependencies": {
        "tsdown": "^0.18.4",
        "rolldown": "^1.0.0-rc.9",

        "vite": "^8.0.0",
        "vitest": "^4.0.18",
        "@vitest/browser-preview": "^4.0.18",

        "typescript": "~5.9.3",

        "@types/node": "^25.3.2",

        "bumpp": "^10.4.1",
        "concurrently": "^9.2.1"
    }
}
